<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Coreshift Tender Screener</title>
<style>
:root { color-scheme: light; }
* { box-sizing: border-box; }
body {
  margin: 0;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
  font-size: 14px;
  color: #1a1a1a;
  background: #fafaf8;
  line-height: 1.45;
}
.wrap { max-width: 1280px; margin: 0 auto; padding: 20px 24px 80px; }
header { display: flex; align-items: baseline; gap: 16px; flex-wrap: wrap; margin-bottom: 4px; }
h1 { font-size: 20px; font-weight: 600; margin: 0; letter-spacing: -0.01em; }
.subtitle { font-size: 12px; color: #888; }
.banner {
  background: #f4f7fb;
  border: 1px solid #d8e2ef;
  color: #2b4868;
  padding: 10px 14px;
  border-radius: 6px;
  font-size: 13px;
  margin: 12px 0 18px;
  display: flex; gap: 16px; flex-wrap: wrap; align-items: center;
}
.banner strong { color: #1a3050; }
.banner .new-pill {
  display: inline-block; font-size: 11px; font-weight: 600;
  padding: 2px 7px; background: #d6f3dc; color: #126b29; border-radius: 3px;
}
.toolbar {
  display: flex; gap: 12px; align-items: center; flex-wrap: wrap;
  padding: 10px 12px; background: #fff; border: 1px solid #eaeae3;
  border-radius: 8px; margin-bottom: 14px;
}
.toolbar label { font-size: 12px; color: #555; display: flex; align-items: center; gap: 6px; }
.toolbar input[type=text], .toolbar select {
  font-size: 13px; padding: 5px 8px; border: 1px solid #d6d6cf; border-radius: 5px;
  background: #fff;
}
.toolbar input[type=range] { width: 110px; }
.counts { margin-left: auto; font-size: 12px; color: #777; }
table { width: 100%; border-collapse: separate; border-spacing: 0; background: #fff;
  border: 1px solid #eaeae3; border-radius: 8px; overflow: hidden; }
thead th {
  font-size: 11px; text-transform: uppercase; letter-spacing: 0.04em; color: #777;
  font-weight: 600; text-align: left; padding: 10px 12px;
  background: #f6f6f0; border-bottom: 1px solid #eaeae3; cursor: pointer; user-select: none;
}
thead th.sortable:hover { background: #efefe7; }
thead th .sort-ind { color: #bbb; margin-left: 3px; font-size: 10px; }
tbody td { padding: 10px 12px; border-bottom: 1px solid #f0f0e8; vertical-align: top; }
tbody tr:last-child td { border-bottom: none; }
tbody tr.dismissed { opacity: 0.42; }
tbody tr.expanded > td { background: #fbfaf3; }
.star { font-size: 16px; cursor: pointer; user-select: none; color: #ccc; }
.star.on { color: #f5b400; }
.fit { display: inline-flex; align-items: center; justify-content: center;
  min-width: 30px; padding: 2px 7px; border-radius: 4px;
  font-weight: 600; font-size: 12px; font-variant-numeric: tabular-nums; }
.fit.s90 { background: #d6f3dc; color: #126b29; }
.fit.s70 { background: #e6f3d6; color: #3d6b12; }
.fit.s50 { background: #fdf4cd; color: #7a5800; }
.fit.s30 { background: #fde0cd; color: #803400; }
.fit.s0  { background: #f0e0e0; color: #6b1212; }
.close-date { font-variant-numeric: tabular-nums; font-size: 13px; }
.close-date .days { display: block; font-size: 11px; color: #888; }
.close-date.urgent .days { color: #b00; font-weight: 600; }
.close-date.soon .days   { color: #c87800; font-weight: 600; }
.title-cell { font-weight: 500; cursor: pointer; }
.title-cell:hover { color: #0a58c2; }
.title-cell .new-tag {
  display: inline-block; font-size: 10px; font-weight: 700; letter-spacing: 0.04em;
  padding: 1px 5px; background: #d6f3dc; color: #126b29; border-radius: 3px;
  margin-right: 6px; vertical-align: middle;
}
.agency { font-size: 12px; color: #555; }
.type-pill {
  display: inline-block; font-size: 11px; padding: 1px 6px;
  background: #eef0f2; color: #444; border-radius: 3px;
}
.ref { font-size: 11px; color: #888; font-variant-numeric: tabular-nums; }
.actions { display: flex; gap: 4px; }
.btn {
  font-size: 11px; padding: 3px 8px; border: 1px solid #d6d6cf;
  background: #fff; border-radius: 4px; cursor: pointer; color: #444;
}
.btn:hover { background: #f3f3ee; }
.btn.danger:hover { background: #ffeaea; color: #a00; border-color: #f0bbbb; }
.btn.primary { background: #0a58c2; color: #fff; border-color: #0a58c2; }
.btn.primary:hover { background: #094aa3; }
.expand-row td { padding: 14px 18px 16px; background: #fbfaf3; }
.expand-grid {
  display: grid; grid-template-columns: minmax(0, 1fr) 320px;
  gap: 22px;
}
.expand-grid h4 { margin: 0 0 6px; font-size: 12px; text-transform: uppercase;
  letter-spacing: 0.04em; color: #777; font-weight: 600; }
.reasons { list-style: none; padding: 0; margin: 0; }
.reasons li { font-size: 13px; padding: 3px 0; }
.reasons li.plus::before  { content: "+ "; color: #126b29; font-weight: 700; }
.reasons li.minus::before { content: "− "; color: #a00; font-weight: 700; }
.reasons li.neutral::before { content: "· "; color: #888; }
.notes-box { width: 100%; min-height: 70px; padding: 8px; border: 1px solid #d6d6cf;
  border-radius: 5px; font-family: inherit; font-size: 13px; resize: vertical;
  background: #fff; }
.meta-line { font-size: 12px; color: #666; margin-top: 8px; }
.meta-line a { color: #0a58c2; }
.empty { text-align: center; padding: 36px; color: #888; font-size: 13px; }
.legend { font-size: 11px; color: #777; margin-top: 12px; display: flex; gap: 14px; flex-wrap: wrap; }
.legend span { display: inline-flex; align-items: center; gap: 5px; }
.swatch { width: 10px; height: 10px; border-radius: 2px; display: inline-block; }
.footnote { font-size: 11px; color: #999; margin-top: 24px; text-align: center; }
</style>
</head>
<body>
<div class="wrap">

<header>
  <h1>Tender Screener — Coreshift</h1>
  <span class="subtitle">NZ GETS · light triage</span>
  <span class="counts" id="counts"></span>
</header>

<div class="banner">
  <span><strong>Last refreshed:</strong> {{ generated_at_display }}</span>
  <span><strong>{{ item_count }}</strong> active tenders</span>
  {% if new_count > 0 %}<span class="new-pill">{{ new_count }} new since last run</span>{% endif %}
  <span style="margin-left:auto;color:#7a8ba0;font-size:12px;">Scoring is metadata-only (title). Click through to GETS for the full RFP.</span>
</div>

<div class="toolbar">
  <label>Show
    <select id="filter-status">
      <option value="active">Active (not dismissed)</option>
      <option value="starred">Starred only</option>
      <option value="new">New only</option>
      <option value="dismissed">Dismissed only</option>
      <option value="all">All</option>
    </select>
  </label>
  <label>Agency
    <input type="text" id="filter-agency" placeholder="any" size="14">
  </label>
  <label>Title
    <input type="text" id="filter-title" placeholder="keyword" size="14">
  </label>
  <label>Min fit
    <input type="range" id="filter-fit" min="0" max="100" value="0" step="5">
    <span id="filter-fit-val" style="min-width:24px;text-align:right;font-variant-numeric:tabular-nums;">0</span>
  </label>
  <label>Hide closed
    <input type="checkbox" id="filter-open" checked>
  </label>
</div>

<table id="tender-table">
  <thead><tr>
    <th style="width:28px"></th>
    <th class="sortable" data-sort="fitScore">Fit <span class="sort-ind">▼</span></th>
    <th class="sortable" data-sort="daysToClose">Close <span class="sort-ind"></span></th>
    <th class="sortable" data-sort="title" style="min-width:280px">Tender <span class="sort-ind"></span></th>
    <th class="sortable" data-sort="organization">Agency <span class="sort-ind"></span></th>
    <th>Type</th>
    <th></th>
  </tr></thead>
  <tbody id="tbody"></tbody>
</table>

<div class="legend">
  <span><span class="swatch" style="background:#d6f3dc"></span>Strong fit (≥80)</span>
  <span><span class="swatch" style="background:#e6f3d6"></span>Worth a read (60–79)</span>
  <span><span class="swatch" style="background:#fdf4cd"></span>Marginal (40–59)</span>
  <span><span class="swatch" style="background:#fde0cd"></span>Weak (20–39)</span>
  <span><span class="swatch" style="background:#f0e0e0"></span>Auto-reject (&lt;20)</span>
</div>

<p class="footnote">Stars / dismissals / notes persist in this browser only. Generated {{ generated_at }}.</p>

</div>

<script>
const ITEMS = {{ items_json | safe }};

const LS_KEY = "coreshift_tender_screener_v1";
let state = JSON.parse(localStorage.getItem(LS_KEY) || "{}");
state.starred  = new Set(state.starred  || []);
state.dismissed = new Set(state.dismissed || []);
state.notes    = state.notes || {};
state.expanded = new Set(state.expanded || []);
state.sortBy   = state.sortBy || "fitScore";
state.sortDir  = state.sortDir || "desc";

function saveState() {
  localStorage.setItem(LS_KEY, JSON.stringify({
    starred:   [...state.starred],
    dismissed: [...state.dismissed],
    notes:     state.notes,
    expanded:  [...state.expanded],
    sortBy:    state.sortBy,
    sortDir:   state.sortDir
  }));
}

function fitClass(s) {
  if (s >= 80) return "s90";
  if (s >= 60) return "s70";
  if (s >= 40) return "s50";
  if (s >= 20) return "s30";
  return "s0";
}
function closeUrgency(days) {
  if (days == null) return "normal";
  if (days < 0) return "closed";
  if (days <= 7) return "urgent";
  if (days <= 14) return "soon";
  return "normal";
}
function daysLabel(days) {
  if (days == null) return "—";
  if (days < 0) return "closed";
  if (days === 0) return "today";
  if (days === 1) return "1 day";
  return days + " days";
}
function closeDateShort(raw) {
  // "4:30 PM 13 May 2026 (Pacific/Auckland UTC+12:00)" -> "13 May 2026"
  const m = raw.match(/(\d{1,2}\s+\w+\s+\d{4})/);
  return m ? m[1] : raw;
}

function getFilters() {
  return {
    status: document.getElementById("filter-status").value,
    agency: document.getElementById("filter-agency").value.trim().toLowerCase(),
    title:  document.getElementById("filter-title").value.trim().toLowerCase(),
    minFit: +document.getElementById("filter-fit").value,
    openOnly: document.getElementById("filter-open").checked
  };
}

function render() {
  const f = getFilters();
  const tbody = document.getElementById("tbody");
  tbody.innerHTML = "";

  let view = ITEMS.filter(it => {
    if (f.status === "active"    && state.dismissed.has(it.rfxId)) return false;
    if (f.status === "starred"   && !state.starred.has(it.rfxId))   return false;
    if (f.status === "new"       && !it.isNew)                       return false;
    if (f.status === "dismissed" && !state.dismissed.has(it.rfxId)) return false;
    if (f.agency && !it.organization.toLowerCase().includes(f.agency)) return false;
    if (f.title  && !it.title.toLowerCase().includes(f.title))         return false;
    if (it.fitScore < f.minFit) return false;
    if (f.openOnly && it.daysToClose != null && it.daysToClose < 0) return false;
    return true;
  });

  view.sort((a, b) => {
    const dir = state.sortDir === "asc" ? 1 : -1;
    const k = state.sortBy;
    if (k === "title" || k === "organization") return dir * (a[k] > b[k] ? 1 : -1);
    const av = a[k] ?? (k === "daysToClose" ? 9999 : 0);
    const bv = b[k] ?? (k === "daysToClose" ? 9999 : 0);
    return dir * (av - bv);
  });

  document.getElementById("counts").textContent =
    `${view.length} shown · ${ITEMS.length} total · ${state.starred.size} starred · ${state.dismissed.size} dismissed`;

  if (view.length === 0) {
    tbody.innerHTML = '<tr><td colspan="7" class="empty">No tenders match the current filters.</td></tr>';
    return;
  }

  for (const it of view) {
    const tr = document.createElement("tr");
    if (state.dismissed.has(it.rfxId)) tr.classList.add("dismissed");
    const urg = closeUrgency(it.daysToClose);
    const newTag = it.isNew ? '<span class="new-tag">NEW</span>' : '';
    tr.innerHTML = `
      <td><span class="star ${state.starred.has(it.rfxId) ? "on" : ""}" data-id="${it.rfxId}">★</span></td>
      <td><span class="fit ${fitClass(it.fitScore)}">${it.fitScore}</span></td>
      <td class="close-date ${urg}">${closeDateShort(it.closeDateRaw)}<span class="days">${daysLabel(it.daysToClose)}</span></td>
      <td class="title-cell" data-id="${it.rfxId}">${newTag}${escapeHtml(it.title)}</td>
      <td class="agency">${escapeHtml(it.organization)}</td>
      <td><span class="type-pill" title="${escapeHtml(it.tenderType)}">${escapeHtml(it.tenderTypeCode || it.tenderType)}</span></td>
      <td class="actions">
        <button class="btn" data-id="${it.rfxId}" data-act="toggle-expand">${state.expanded.has(it.rfxId) ? "Hide" : "Details"}</button>
        <button class="btn danger" data-id="${it.rfxId}" data-act="dismiss">${state.dismissed.has(it.rfxId) ? "Restore" : "Dismiss"}</button>
      </td>`;
    tbody.appendChild(tr);

    if (state.expanded.has(it.rfxId)) {
      tr.classList.add("expanded");
      const er = document.createElement("tr");
      er.className = "expand-row";
      const reasonsHtml = it.reasons.length
        ? it.reasons.map(r => `<li class="${r.kind}">${escapeHtml(r.text)}</li>`).join("")
        : '<li class="neutral">No keyword signals fired — title is generic; only click-through can tell.</li>';
      er.innerHTML = `
        <td colspan="7">
          <div class="expand-grid">
            <div>
              <h4>Why this score</h4>
              <ul class="reasons">${reasonsHtml}</ul>
              <div class="meta-line">
                Ref <span class="ref">${escapeHtml(it.referenceNumber)}</span> ·
                RFx <span class="ref">${escapeHtml(it.rfxId)}</span> ·
                Closes ${escapeHtml(it.closeDateRaw)} ·
                <a href="${it.url}" target="_blank" rel="noopener">Open in GETS ↗</a>
              </div>
            </div>
            <div>
              <h4>Notes</h4>
              <textarea class="notes-box" data-id="${it.rfxId}" placeholder="Your notes, follow-ups…">${escapeHtml(state.notes[it.rfxId] || "")}</textarea>
            </div>
          </div>
        </td>`;
      tbody.appendChild(er);
    }
  }
}

function escapeHtml(s) {
  return String(s ?? "").replace(/[&<>"']/g, c => ({
    "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;"
  })[c]);
}

document.getElementById("tbody").addEventListener("click", (e) => {
  const t = e.target;
  const id = t.dataset.id;
  if (!id) return;

  if (t.classList.contains("star")) {
    if (state.starred.has(id)) state.starred.delete(id);
    else state.starred.add(id);
    saveState(); render(); return;
  }
  if (t.classList.contains("title-cell") || t.dataset.act === "toggle-expand") {
    if (state.expanded.has(id)) state.expanded.delete(id);
    else state.expanded.add(id);
    saveState(); render(); return;
  }
  if (t.dataset.act === "dismiss") {
    if (state.dismissed.has(id)) state.dismissed.delete(id);
    else state.dismissed.add(id);
    saveState(); render();
  }
});

document.getElementById("tbody").addEventListener("input", (e) => {
  if (e.target.classList.contains("notes-box")) {
    state.notes[e.target.dataset.id] = e.target.value;
    saveState();
  }
});

document.querySelectorAll("thead th.sortable").forEach(th => {
  th.addEventListener("click", () => {
    const k = th.dataset.sort;
    if (state.sortBy === k) state.sortDir = state.sortDir === "asc" ? "desc" : "asc";
    else { state.sortBy = k; state.sortDir = k === "daysToClose" ? "asc" : "desc"; }
    document.querySelectorAll("thead th .sort-ind").forEach(s => s.textContent = "");
    th.querySelector(".sort-ind").textContent = state.sortDir === "asc" ? "▲" : "▼";
    saveState(); render();
  });
});

["filter-status","filter-agency","filter-title","filter-fit","filter-open"].forEach(id => {
  document.getElementById(id).addEventListener("input", () => {
    if (id === "filter-fit") document.getElementById("filter-fit-val").textContent = document.getElementById("filter-fit").value;
    render();
  });
});

const initTh = document.querySelector(`thead th[data-sort="${state.sortBy}"] .sort-ind`);
if (initTh) initTh.textContent = state.sortDir === "asc" ? "▲" : "▼";

render();
</script>
</body>
</html>
